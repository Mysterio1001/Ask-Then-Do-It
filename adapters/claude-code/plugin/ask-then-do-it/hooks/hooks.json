{
  "description": "Route Ask Then Do It public entries with session-isolated Claude model state.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/router.mjs",
              "session-start"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/router.mjs",
              "pre-model-switch"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/router.mjs",
              "post-model-switch"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^ask-then-do-it:ask-then-do-it$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/router.mjs",
              "user-prompt-expansion",
              "ask-then-do-it:ask-then-do-it"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^ask-then-do-it:ask-then-do-it-5$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/router.mjs",
              "user-prompt-expansion",
              "ask-then-do-it:ask-then-do-it-5"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
